{
  "name": "vue-dockable-desktop",
  "version": "1.11.0",
  "description": "Vue 3 port of react-dockable-desktop — a dockable layout engine with split docking, tabbed groups, floating windows and zero-unmount panel persistence.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipecarrillo100/vue-dockable-desktop.git"
  },
  "homepage": "https://github.com/felipecarrillo100/vue-dockable-desktop#readme",
  "bugs": {
    "url": "https://github.com/felipecarrillo100/vue-dockable-desktop/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepublishOnly": "npm run gate -- M14",
    "dev": "vite",
    "playground": "vite playground",
    "build": "node scripts/build-css.mjs && vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/copy-css.mjs",
    "css": "node scripts/build-css.mjs",
    "css:check": "node scripts/build-css.mjs --check",
    "css:watch": "node scripts/build-css.mjs --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "node scripts/gate.mjs",
    "gate:release": "npm run gate:sweep && node scripts/gate.mjs M1 M2 M3 M4 M5 M6 M7 M8 M9 M10 M11 M12 M13 M14 M15 M16 M17",
    "verify": "node scripts/verify.mjs",
    "gate:selftest": "node scripts/gates/selftest.mjs",
    "gate:sweep": "vitest run --coverage --silent && node scripts/gates/non-vacuity.mjs",
    "demo": "vite demo",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vue",
    "vue3",
    "react-dockable-desktop",
    "dockable-desktop",
    "dockable",
    "layout",
    "window-manager",
    "docking",
    "panels",
    "workspace",
    "ide"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "bootstrap": "^5.3.8",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.0.1",
    "katex": "^0.18.7",
    "leaflet": "^1.9.4",
    "monaco-editor": "^0.56.0",
    "playwright-core": "^1.63.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.0",
    "unified": "^11.0.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
